# MediStock Environment Configuration Template
# Copy this file to .env and insert your real credentials when connecting to Supabase

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional Google OAuth Client ID (for Google Identity Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

